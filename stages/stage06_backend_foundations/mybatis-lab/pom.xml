<?xml version="1.0" encoding="UTF-8"?>
<!-- 课 7 的 MyBatis 独立模块：只依赖 mybatis + mysql-connector-j（编译验证）。
     ⚠️ 本模块当前验证等级 = 编译通过 + 静态核对；真实 MySQL 集成测试因开发环境无运行中的
     Docker/MySQL（阻断记录见 docs/overhaul-v2.5/07_DATABASE_INTEGRATION.md）尚未执行。
     不引入 spring-boot-starter，避免 student-api 主工程在无数据库环境下无法启动。 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.javaroadmap</groupId>
  <artifactId>stage06-mybatis-lab</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <mybatis.version>3.5.16</mybatis.version>
    <mysql.version>8.4.0</mysql.version>
    <surefire.version>3.5.2</surefire.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.mybatis</groupId>
      <artifactId>mybatis</artifactId>
      <version>${mybatis.version}</version>
    </dependency>
    <!-- MySQL 官方驱动（与 Stage 05 同版本）：仅编译与将来真库运行使用 -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <version>${mysql.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.11.3</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${surefire.version}</version>
      </plugin>
    </plugins>
  </build>
</project>

<?xml version="1.0" encoding="UTF-8"?>
<!-- Stage 06 课 1-3 的演练工程：纯 JDK + JUnit，无 Spring。
     学习者第一次面对的 pom.xml——每个元素都会在课程正文里被解释，而不是背诵。 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- 坐标：Maven 世界里定位一个构件的三元组 -->
  <groupId>com.javaroadmap</groupId>
  <artifactId>stage06-maven-lab</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>

  <properties>
    <!-- 学习者最低需要 JDK 21（LTS）；本仓库用 JDK 25 构建验证 -->
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.11.3</junit.version>
    <surefire.version>3.5.2</surefire.version>
  </properties>

  <dependencies>
    <!-- JUnit 5：scope=test 表示只在编译与运行测试时可用，不会进入最终 jar -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${surefire.version}</version>
      </plugin>
    </plugins>
  </build>
</project>

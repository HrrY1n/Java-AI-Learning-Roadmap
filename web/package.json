{
  "name": "javaroadmap-lab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "dompurify": "3.4.17"
  },
  "scripts": {
    "content": "node scripts/generate-content.mjs",
    "dev": "npm run content && vite --host 127.0.0.1",
    "typecheck": "npm run content && tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "check:build": "node scripts/check-build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "npm run content && vitest run && node --test scripts/content.test.mjs scripts/verify-practice.test.mjs scripts/prediction-semantics.test.mjs",
    "test:unit": "npm run content && vitest run",
    "test:e2e": "npm run content && playwright test",
    "test:pages": "playwright test --config playwright.pages.config.ts",
    "verify:practice": "node scripts/verify-practice.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "highlight.js": "11.11.1",
    "lucide-react": "1.64.0",
    "monaco-editor": "0.57.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "tailwindcss": "4.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "fake-indexeddb": "6.2.6",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
